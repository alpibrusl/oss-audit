# Backend LLM (auto-detect si no se define).
# Opciones: anthropic-api | claude-cli | openai-compatible
# OSS_AUDITOR_BACKEND=claude-cli

# Modelo. Default: claude-opus-4-7 (anthropic/claude-cli) o gpt-4o (openai).
# OSS_AUDITOR_MODEL=claude-sonnet-4-6

# --- Anthropic API key (factura aparte de tu suscripción Pro/Max) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Claude CLI: usa tu suscripción Pro/Max ---
# Solo necesitas tener `claude` instalado y autenticado (claude login).

# --- OpenAI-compatible (OpenAI, Ollama, OpenRouter, Groq, vLLM, ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # ó http://localhost:11434/v1 para Ollama

# Token de GitHub (recomendado: ratelimit 5000 req/h vs 60 sin token)
GITHUB_TOKEN=ghp_...
